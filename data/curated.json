{
 "poems": [
  {
   "t": "判词·林黛玉与薛宝钗",
   "ch": 5,
   "who": [
    "林黛玉",
    "薛宝钗"
   ],
   "kind": "判词",
   "txt": "可叹停机德，堪怜咏絮才。玉带林中挂，金簪雪里埋。"
  },
  {
   "t": "判词·贾元春",
   "ch": 5,
   "who": [
    "贾元春"
   ],
   "kind": "判词",
   "txt": "二十年来辨是非，榴花开处照宫闱。三春争及初春景，虎兕相逢大梦归。"
  },
  {
   "t": "判词·贾探春",
   "ch": 5,
   "who": [
    "贾探春"
   ],
   "kind": "判词",
   "txt": "才自精明志自高，生于末世运偏消。清明涕送江边望，千里东风一梦遥。"
  },
  {
   "t": "判词·史湘云",
   "ch": 5,
   "who": [
    "史湘云"
   ],
   "kind": "判词",
   "txt": "富贵又何为，襁褓之间父母违。展眼吊斜晖，湘江水逝楚云飞。"
  },
  {
   "t": "判词·王熙凤",
   "ch": 5,
   "who": [
    "王熙凤"
   ],
   "kind": "判词",
   "txt": "凡鸟偏从末世来，都知爱慕此生才。一从二令三人木，哭向金陵事更哀。"
  },
  {
   "t": "判词·贾迎春",
   "ch": 5,
   "who": [
    "贾迎春"
   ],
   "kind": "判词",
   "txt": "子系中山狼，得志便猖狂。金闺花柳质，一载赴黄粱。"
  },
  {
   "t": "判词·贾惜春",
   "ch": 5,
   "who": [
    "贾惜春"
   ],
   "kind": "判词",
   "txt": "勘破三春景不长，缁衣顿改昔年妆。可怜绣户侯门女，独卧青灯古佛旁。"
  },
  {
   "t": "判词·妙玉",
   "ch": 5,
   "who": [
    "妙玉"
   ],
   "kind": "判词",
   "txt": "欲洁何曾洁，云空未必空。可怜金玉质，终陷淖泥中。"
  },
  {
   "t": "判词·秦可卿",
   "ch": 5,
   "who": [
    "秦可卿"
   ],
   "kind": "判词",
   "txt": "情天情海幻情身，情既相逢必主淫。漫言不肖皆荣出，造衅开端实在宁。"
  },
  {
   "t": "枉凝眉",
   "ch": 5,
   "who": [
    "贾宝玉",
    "林黛玉"
   ],
   "kind": "曲",
   "txt": "一个是阆苑仙葩，一个是美玉无瑕。若说没奇缘，今生偏又遇着他；若说有奇缘，如何心事终虚化？一个枉自嗟呀，一个空劳牵挂。一个是水中月，一个是镜中花。想眼中能有多少泪珠儿，怎经得秋流到冬尽，春流到夏！"
  },
  {
   "t": "终身误",
   "ch": 5,
   "who": [
    "贾宝玉",
    "薛宝钗",
    "林黛玉"
   ],
   "kind": "曲",
   "txt": "都道是金玉良姻，俺只念木石前盟。空对着，山中高士晶莹雪；终不忘，世外仙姝寂寞林。叹人间，美中不足今方信：纵然是齐眉举案，到底意难平。"
  },
  {
   "t": "好了歌",
   "ch": 1,
   "who": [
    "甄士隐"
   ],
   "kind": "歌谣",
   "txt": "世人都晓神仙好，惟有功名忘不了！古今将相在何方？荒冢一堆草没了。世人都晓神仙好，只有金银忘不了！终朝只恨聚无多，及到多时眼闭了。世人都晓神仙好，只有姣妻忘不了！君生日日说恩情，君死又随人去了。世人都晓神仙好，只有儿孙忘不了！痴心父母古来多，孝顺儿孙谁见了？"
  },
  {
   "t": "葬花吟",
   "ch": 27,
   "who": [
    "林黛玉"
   ],
   "kind": "长诗",
   "txt": "花谢花飞花满天，红消香断有谁怜？游丝软系飘春榭，落絮轻沾扑绣帘。…一年三百六十日，风刀霜剑严相逼。…侬今葬花人笑痴，他年葬侬知是谁？…一朝春尽红颜老，花落人亡两不知！"
  },
  {
   "t": "题帕三绝（其一）",
   "ch": 34,
   "who": [
    "林黛玉"
   ],
   "kind": "绝句",
   "txt": "眼空蓄泪泪空垂，暗洒闲抛却为谁？尺幅鲛绡劳解赠，叫人焉得不伤悲。"
  },
  {
   "t": "秋窗风雨夕",
   "ch": 45,
   "who": [
    "林黛玉"
   ],
   "kind": "长诗",
   "txt": "秋花惨淡秋草黄，耿耿秋灯秋夜长。已觉秋窗秋不尽，那堪风雨助凄凉！…寒烟小院转萧条，疏竹虚窗时滴沥。不知风雨几时休，已教泪洒窗纱湿。"
  },
  {
   "t": "咏白海棠·黛玉",
   "ch": 37,
   "who": [
    "林黛玉"
   ],
   "kind": "律诗",
   "txt": "半卷湘帘半掩门，碾冰为土玉为盆。偷来梨蕊三分白，借得梅花一缕魂。月窟仙人缝缟袂，秋闺怨女拭啼痕。娇羞默默同谁诉，倦倚西风夜已昏。"
  },
  {
   "t": "咏白海棠·宝钗",
   "ch": 37,
   "who": [
    "薛宝钗"
   ],
   "kind": "律诗",
   "txt": "珍重芳姿昼掩门，自携手瓮灌苔盆。胭脂洗出秋阶影，冰雪招来露砌魂。淡极始知花更艳，愁多焉得玉无痕。欲偿白帝凭清洁，不语婷婷日又昏。"
  },
  {
   "t": "菊花诗·咏菊（黛玉夺魁）",
   "ch": 38,
   "who": [
    "林黛玉"
   ],
   "kind": "律诗",
   "txt": "无赖诗魔昏晓侵，绕篱欹石自沉音。毫端蕴秀临霜写，口齿噙香对月吟。满纸自怜题素怨，片言谁解诉秋心。一从陶令平章后，千古高风说到今。"
  },
  {
   "t": "螃蟹咏（宝钗讽世）",
   "ch": 38,
   "who": [
    "薛宝钗"
   ],
   "kind": "律诗",
   "txt": "桂霭桐阴坐举觞，长安涎口盼重阳。眼前道路无经纬，皮里春秋空黑黄。"
  },
  {
   "t": "柳絮词·唐多令（黛玉）",
   "ch": 70,
   "who": [
    "林黛玉"
   ],
   "kind": "词",
   "txt": "粉堕百花洲，香残燕子楼。一团团、逐对成毬。飘泊亦如人命薄，空缱绻，说风流。草木也知愁，韶华竟白头。叹今生、谁舍谁收！嫁与东风春不管，凭尔去，忍淹留。"
  },
  {
   "t": "柳絮词·临江仙（宝钗）",
   "ch": 70,
   "who": [
    "薛宝钗"
   ],
   "kind": "词",
   "txt": "白玉堂前春解舞，东风卷得均匀。蜂团蝶阵乱纷纷。几曾随逝水？岂必委芳尘？万缕千丝终不改，任他随聚随分。韶华休笑本无根：好风凭借力，送我上青云。"
  },
  {
   "t": "桃花行",
   "ch": 70,
   "who": [
    "林黛玉"
   ],
   "kind": "长诗",
   "txt": "桃花帘外东风软，桃花帘内晨妆懒。帘外桃花帘内人，人与桃花隔不远。…泪眼观花泪易干，泪干春尽花憔悴。憔悴花遮憔悴人，花飞人倦易黄昏。"
  },
  {
